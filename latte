#!/bin/bash

TARGET_ROOT="/"

DB_DIR="$TARGET_ROOT/var/lib/latte"
MANIFEST_DIR="$DB_DIR/manifests"
DB_FILE="$DB_DIR/installed.db"


if (($EUID != 0)); then
    echo "Run as root to use Latte"
    exit 1
fi

mkdir -p "$MANIFEST_DIR"
touch "$DB_FILE"

install_package() {
    local pkg_archive="$1"

    if [ ! -f "$pkg_archive" ]; then
        echo "Error: package '$pkg_archive' was not found"
        return 1
    fi

    local tmp_dir=$(mktemp -d)

    trap 'rm -rf "$tmp_dir"' RETURN

    tar -xzf "$pkg_archive" -C "$tmp_dir" metadata.txt ./metadata.txt 2>/dev/null

    if [ -f "$tmp_dir/./metadata.txt" ] && [ ! -f "$tmp_dir/metadata.txt" ]; then
        mv "$tmp_dir/./metadata.txt" "$tmp_dir/metadata.txt" 2>/dev/null
    fi

    if [ ! -f "$tmp_dir/metadata.txt" ]; then
        echo "Error: Invalid .latte file. metadata.txt not found in archive"
        return 1
    fi


    NAME=$(grep -E '^NAME=' "$tmp_dir/metadata.txt" | head -1 | cut -d= -f2- | tr -d '"')
    VERSION=$(grep -E '^VERSION=' "$tmp_dir/metadata.txt" | head -1 | cut -d= -f2- | tr -d '"')

    [[ -z "$NAME" || -z "$VERSION" ]] && { echo "Error: NAME or VERSION missing in metadata.txt"; exit 1; }
    [[ "$NAME" =~ ^[a-zA-Z0-9._-]+$ ]] || { echo "Error: Invalid NAME (only alphanumeric, ., , - allowed)"; exit 1; }
    [[ "$VERSION" =~ ^[a-zA-Z0-9.-]+$ ]] || { echo "Error: Invalid VERSION (only alphanumeric, ., _, - allowed)"; exit 1; }
    rm -rf "$tmp_dir"

    echo "Installing $NAME $VERSION..."

    tar --exclude='metadata.txt' -xzvf "$pkg_archive" -C "$TARGET_ROOT" | 
        sed -e 's|^\./||' -e 's|^\.||' | 
        grep -v -E '(^/$|^$)' > "$MANIFEST_DIR/$NAME.list"

    sed -i "/^$NAME /d" "$DB_FILE"
    echo "$NAME $VERSION" >> "$DB_FILE"

    echo "Successfully installed $NAME $VERSION"
}

remove_package() {
    local pkg_name="$1"

    if ! grep -q "^$pkg_name " "$DB_FILE"; then
        echo "Error: Package '$pkg_name' is not installed."
        exit 1
    fi

    echo "Removing $pkg_name"

    local manifest="$MANIFEST_DIR/$pkg_name.list"
    if [ -f "$manifest" ]; then
        while read -r file; do
            local target_path="${TARGET_ROOT%/}/$file"
            
            if [ -n "$file" ] && [ -f "$target_path" ]; then
                rm -f "$target_path"
            elif [ -n "$file" ] && [ -d "$target_path" ]; then
                rmdir "$target_path" 2>/dev/null
            fi
        done < <(tac "$manifest")
        
        rm -f "$manifest"
    fi

    sed -i "/^$pkg_name /d" "$DB_FILE"
    echo "Successfully removed $pkg_name."
}

list_packages() {
    cat $DB_FILE
}

latte_version() {
    echo "Latte v1.0 stable | Capuccino"
}

build_package() {
    local inputdir="${1%/}"
    local outputdir="$2"

    if [[ ! -d "$inputdir" ]]; then
        echo "directory $inputdir not found"
        return 1
    fi

    local final_archive="$outputdir"

    if [[ "$outputdir" == *.latte ]]; then
        final_archive="$outputdir"
        mkdir -p "$(dirname "$final_archive")"
    else
        mkdir -p "$outputdir"
        final_archive="${outputdir%/}/$(basename "$inputdir").latte"
    fi

    echo "Packaging bundle from '$inputdir'..."
    
    if tar -czf "$final_archive" -C "$inputdir" .; then
        echo "Successfully built package: $final_archive"
        return 0
    else
        echo "Error: Failed to create .latte package."
        return 1
    fi
}


if [ "$1" == "install" ]; then
    install_package "$2"
elif [ "$1" == "list" ]; then
    list_packages
elif [ "$1" == "remove" ]; then
    remove_package "$2"
elif [ "$1" == "version" ]; then
    latte_version
elif [ "$1" == "build" ]; then
    build_package "$2" "$3"
else
    echo "Usage:
    latte install <package.latte>
    latte list
    latte remove <package>
    latte version
